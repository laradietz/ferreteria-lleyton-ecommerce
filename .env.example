# Copiar como .env y completar antes de desplegar en producción.
# En desarrollo local con `docker compose up`, los valores por defecto alcanzan.

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/ecommerce
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

SERVER_PORT=8080

# Generar una clave real de al menos 256 bits para producción.
JWT_SECRET=cambiar_esta_clave_en_produccion_min_256_bits
JWT_EXPIRATION_MS=86400000

SEED_ENABLED=true
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin123

UPLOAD_DIR=uploads
